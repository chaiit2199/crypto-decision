# Copy to .env and export before starting Mix. Never commit real credentials.
POSTGRES_USER=crypto_decision
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=crypto_decision_lab_dev
POSTGRES_PORT=5433
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=crypto_decision
DB_PASSWORD=local-development-only
DB_NAME=crypto_decision_lab_dev
DB_POOL_SIZE=10
TEST_DB_NAME=crypto_decision_lab_test
PORT=4000
# Dev defaults to true; production must opt in explicitly.
MARKET_SYNC_ENABLED=true
BINANCE_BASE_URL=https://data-api.binance.vision/api/v3
# Jev is opt-in, independently of market collection; never expose the key to Next.js.
JEV_ENABLED=true
TYPESAFE_API_KEY=apikey_26348e6614ce2444c44a810858bc7a2ebe4_455c0c46b6e2a3fc00023bc52a227a51bababd76fce302ef4e54fa62734f30fe
# Select a model returned by GET https://api.typesafe.ai/v1/models.
JEV_MODEL=jev-latest
# Development connection is configured in apps/api/config/dev.exs.
# Production reads DATABASE_URL (preferred) or DB_* plus SECRET_KEY_BASE at runtime.
# Production DB_PORT defaults to 5432; local Compose maps the host port to 5433.
